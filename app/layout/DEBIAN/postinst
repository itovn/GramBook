#!/bin/sh
# Công cụ cài bản cập nhật OTA cần quyền root: dpkg -i, đóng / mở lại app, khởi động lại SpringBoard — app/Helper/gbupdate.c
chown root:wheel /usr/libexec/grambook /usr/libexec/grambook/gbupdate
chmod 0755 /usr/libexec/grambook
chmod 4755 /usr/libexec/grambook/gbupdate
# SpringBoard iOS 5 / 6 giữ biểu tượng đã dựng trong IconsCache (respring cũng không đọc lại Icon*.png): xoá mục của app để
# biểu tượng mới hiện khi SpringBoard khởi động lại. Chỉ là bộ đệm, SpringBoard tự dựng lại.
rm -f /var/mobile/Library/Caches/com.apple.IconsCache/vn.grambook.app_*
# Khởi động lại SpringBoard sau khi cài / cập nhật (như GramMini — biểu tượng mới…):
# - cập nhật OTA: gbupdate tự làm sau dpkg (đặt GRAMBOOK_OTA=1) → bỏ qua ở đây;
# - Cydia: xin nút «Restart SpringBoard»;
# - cài tay bằng dpkg qua SSH: không làm gì.
if [ "$1" = configure ] && [ -z "$GRAMBOOK_OTA" ] && [ -n "$CYDIA" ]; then
    eval "echo 'finish:restart' >&${CYDIA%% *}"
fi
exit 0
